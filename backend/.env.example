# Copy to backend/.env and fill in. Never commit backend/.env.
# All secrets are read from the environment only.

# --- App ---
APP_ENV=dev                      # dev | test | staging | prod (staging/prod refuse to start without the secrets below)
LOG_JSON=false                   # true outside dev
DATABASE_URL=postgresql+asyncpg://zentrix:zentrix@localhost:5432/zentrix
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=                    # comma-separated; empty = no CORS (mobile apps do not need it)
TRUST_PROXY_HEADERS=false        # true only behind a trusted reverse proxy (X-Forwarded-For)

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
AUDIT_SALT=
# Google OAuth client IDs whose ID tokens we accept (Android, iOS, web), comma-separated.
GOOGLE_CLIENT_IDS=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# --- Rate limits ("count/seconds") ---
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_REFRESH=30/60
RATE_LIMIT_PUBLIC=120/60
RATE_LIMIT_USER=240/60
RATE_LIMIT_LIVE=150/60           # per IP, live charts poll /v1/candles/live every 2 s
LIVE_CANDLE_CACHE_S=1            # one exchange request per series per second, shared by all viewers

# Billing is out of scope: premium features are unlocked for everyone while false. True locks them to users
# with premium access (admin-set plan, subscription or grant). See docs/API.md "Plans and Premium".
PREMIUM_ENFORCED=false

# Developer sign-in without Google (POST /v1/auth/dev), for running the app locally. Only with APP_ENV=dev.
# DEV_LOGIN=true
# Free tier: live signals for these markets (everything else is the premium feature all_markets)
FREE_SIGNAL_SYMBOLS=EUR/USD,GBP/USD,XAU/USD
FREE_SIGNAL_TIMEFRAMES=15m

# --- Worker (ingestion, signals, outcomes) ---
# ARTIFACTS_DIR=/data/artifacts  # default: backend/ml/artifacts (Docker image sets /data/artifacts)
WORKER_POLL_S=5
INGEST_GRACE_S=3                 # wait after a candle closes before fetching it
INGEST_RETRY_S=30
TWELVE_DATA_DAILY_BUDGET=780     # free plan: 800 requests/day
TWELVE_DATA_MIN_LIVE_TF_S=900    # do not run Twelve Data timeframes below 15m live on the free plan
OUTCOME_VOID_AFTER_S=21600
# BINANCE_SPOT_URL=https://data-api.binance.vision/api/v3/klines   # public-data mirror if api.binance.com is blocked

# --- News guard (economic calendar, refreshed by the worker) ---
NEWS_REFRESH_S=3600              # the feed blocks much faster polling
NEWS_STALE_AFTER_S=21600         # older calendar -> guard state 'unknown'
NEWS_BLACKOUT_BEFORE_S=1800      # high impact: blackout window
NEWS_BLACKOUT_AFTER_S=1800
NEWS_MEDIUM_WINDOW_S=900         # medium impact: caution +/- this
NEWS_HIGH_LEAD_S=7200            # high impact within this -> caution

# --- Market Pulse headlines (refreshed by the worker; see docs/DATA_SOURCES.md for publisher terms) ---
NEWS_FEEDS=                      # empty = all: fed,ecb,boe,boj,sec,fxstreet,investinglive,coindesk,cointelegraph
NEWS_HEADLINES_REFRESH_S=120
NEWS_ITEMS_KEEP_DAYS=7

# --- Alerts and push ---
# Firebase service-account JSON for FCM HTTP v1 (keep it out of git). Empty: pushes are not sent, alerts
# still appear in the in-app inbox.
FCM_CREDENTIALS_FILE=
MAX_ALERTS_PER_USER=50

# --- Market data ---
# Twelve Data (forex/gold). Free plan: 8 requests/min, 800/day, internal non-display use only.
TWELVE_DATA_API_KEY=
TWELVE_DATA_MIN_INTERVAL_S=8

# --- LLM explanations (optional) ---
GEMINI_API_KEY=
