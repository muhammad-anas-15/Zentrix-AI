# Copy to backend/.env and fill in. Never commit backend/.env.
# All secrets are read from the environment only.

# --- Market data ---
# Twelve Data (forex/gold). Free plan: 8 requests/min, 800/day.
TWELVE_DATA_API_KEY=
# Seconds between Twelve Data calls (free plan = 8/min -> 8s).
TWELVE_DATA_MIN_INTERVAL_S=8

# --- LLM explanations (optional) ---
GEMINI_API_KEY=

# --- App (Phase 1+) ---
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://zentrix:zentrix@localhost:5432/zentrix
REDIS_URL=redis://localhost:6379/0
# Billing is out of scope: premium features are unlocked for everyone while false.
PREMIUM_ENFORCED=false
