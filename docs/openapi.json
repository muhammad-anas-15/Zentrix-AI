{
  "components": {
    "schemas": {
      "GoogleSignIn": {
        "properties": {
          "device_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Name"
          },
          "id_token": {
            "description": "Google ID token from google_sign_in",
            "maxLength": 8192,
            "minLength": 20,
            "title": "Id Token",
            "type": "string"
          }
        },
        "required": [
          "id_token"
        ],
        "title": "GoogleSignIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InstrumentOut": {
        "properties": {
          "active": {
            "description": "False until the instrument has a usable data feed",
            "title": "Active",
            "type": "boolean"
          },
          "asset_class": {
            "enum": [
              "fx",
              "metal",
              "commodity",
              "crypto",
              "index",
              "equity"
            ],
            "title": "Asset Class",
            "type": "string"
          },
          "base": {
            "title": "Base",
            "type": "string"
          },
          "contract_size": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Size"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "instrument_type": {
            "enum": [
              "spot",
              "perpetual",
              "future",
              "cfd"
            ],
            "title": "Instrument Type",
            "type": "string"
          },
          "listings": {
            "items": {
              "$ref": "#/components/schemas/ListingOut"
            },
            "title": "Listings",
            "type": "array"
          },
          "price_decimals": {
            "title": "Price Decimals",
            "type": "integer"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "session": {
            "title": "Session",
            "type": "string"
          },
          "settle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Settle"
          },
          "symbol": {
            "description": "Canonical symbol, e.g. EUR/USD, BTC/USDT, BTC/USDT:PERP",
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "display_name",
          "asset_class",
          "instrument_type",
          "base",
          "quote",
          "settle",
          "contract_size",
          "price_decimals",
          "session",
          "active",
          "listings"
        ],
        "title": "InstrumentOut",
        "type": "object"
      },
      "InstrumentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InstrumentOut"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "InstrumentPage",
        "type": "object"
      },
      "ListingOut": {
        "properties": {
          "is_primary": {
            "title": "Is Primary",
            "type": "boolean"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "status": {
            "enum": [
              "active",
              "planned",
              "restricted",
              "disabled"
            ],
            "title": "Status",
            "type": "string"
          },
          "venue": {
            "title": "Venue",
            "type": "string"
          },
          "venue_symbol": {
            "title": "Venue Symbol",
            "type": "string"
          }
        },
        "required": [
          "venue",
          "venue_symbol",
          "status",
          "is_primary",
          "note"
        ],
        "title": "ListingOut",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "TimeframeOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "seconds": {
            "title": "Seconds",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "seconds"
        ],
        "title": "TimeframeOut",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Access token lifetime in seconds",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "user"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "enum": [
              "en",
              "ur"
            ],
            "title": "Locale",
            "type": "string"
          },
          "plan": {
            "enum": [
              "free",
              "premium"
            ],
            "title": "Plan",
            "type": "string"
          },
          "premium_access": {
            "description": "True when premium features are usable (always, while billing is not enforced)",
            "title": "Premium Access",
            "type": "boolean"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "avatar_url",
          "plan",
          "premium_access",
          "locale",
          "timezone",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "UserUpdate": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "locale": {
            "anyOf": [
              {
                "enum": [
                  "en",
                  "ur"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "timezone": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "title": "UserUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VenueOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "kind": {
            "enum": [
              "exchange",
              "data_vendor",
              "broker"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "kind"
        ],
        "title": "VenueOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token from /v1/auth/google or /v1/auth/refresh",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Zentrix: trading analysis and risk tools for FX, metals, commodities and crypto.\n\n**Not financial advice.** Signals are probabilities based on past data, not guarantees. Accuracy figures come\nonly from the out-of-sample track record.",
    "title": "Zentrix API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "ops"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Not ready"
          }
        },
        "summary": "Readiness: database and Redis reachable",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/auth/google": {
      "post": {
        "operationId": "sign_in_google_v1_auth_google_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid or expired token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "summary": "Sign in with a Google ID token; creates the account on first sign-in",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke this device's refresh token (idempotent)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout-all": {
      "post": {
        "operationId": "logout_all_v1_auth_logout_all_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid or expired token"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Sign out everywhere: revoke all refresh tokens and outstanding access tokens",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refresh_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid or expired token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "summary": "Exchange a refresh token for a new pair (the old refresh token becomes invalid)",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/instruments": {
      "get": {
        "operationId": "list_instruments_v1_instruments_get",
        "parameters": [
          {
            "in": "query",
            "name": "asset_class",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "fx",
                    "metal",
                    "commodity",
                    "crypto",
                    "index",
                    "equity"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Asset Class"
            }
          },
          {
            "in": "query",
            "name": "instrument_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "spot",
                    "perpetual",
                    "future",
                    "cfd"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Instrument Type"
            }
          },
          {
            "description": "Venue code, e.g. binance_spot",
            "in": "query",
            "name": "venue",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 32,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Venue code, e.g. binance_spot",
              "title": "Venue"
            }
          },
          {
            "description": "Search symbol or name",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search symbol or name",
              "title": "Q"
            }
          },
          {
            "description": "Also list instruments without a usable feed",
            "in": "query",
            "name": "include_inactive",
            "required": false,
            "schema": {
              "default": false,
              "description": "Also list instruments without a usable feed",
              "title": "Include Inactive",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List instruments across asset classes",
        "tags": [
          "market"
        ]
      }
    },
    "/v1/me": {
      "delete": {
        "operationId": "delete_me_v1_me_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete the account and all its data (required by Google Play). Irreversible.",
        "tags": [
          "account"
        ]
      },
      "get": {
        "operationId": "get_me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Current user",
        "tags": [
          "account"
        ]
      },
      "patch": {
        "operationId": "update_me_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Update profile preferences",
        "tags": [
          "account"
        ]
      }
    },
    "/v1/timeframes": {
      "get": {
        "operationId": "list_timeframes_v1_timeframes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TimeframeOut"
                  },
                  "title": "Response List Timeframes V1 Timeframes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Supported candle timeframes",
        "tags": [
          "market"
        ]
      }
    },
    "/v1/venues": {
      "get": {
        "operationId": "list_venues_v1_venues_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VenueOut"
                  },
                  "title": "Response List Venues V1 Venues Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Exchanges and data vendors",
        "tags": [
          "market"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Google sign-in and sessions",
      "name": "auth"
    },
    {
      "description": "Profile, preferences, account deletion",
      "name": "account"
    },
    {
      "description": "Instruments, venues, timeframes",
      "name": "market"
    },
    {
      "description": "Health checks",
      "name": "ops"
    }
  ]
}
