# Copy to infra/.env on the server (never commit it). One file per environment (staging, prod).
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEPLOY_ENV=staging                      # compose project name suffix: staging | prod
IMAGE_TAG=latest                        # the git short SHA you deploy (rollback = previous tag)
API_DOMAIN=api-staging.example.com      # DNS A/AAAA record -> this server; Caddy gets the TLS certificate

APP_ENV=staging                         # staging | prod: refuses to start without the secrets below
POSTGRES_PASSWORD=
JWT_SECRET=                             # >= 32 chars
AUDIT_SALT=                             # >= 16 chars
GOOGLE_CLIENT_IDS=                      # Android + web OAuth client IDs (comma-separated)
CORS_ORIGINS=                           # empty for the mobile app; set only for a web front end
DOCS_ENABLED=false                      # /docs, /openapi.json off when deployed
METRICS_TOKEN=                          # bearer token for api:8000/metrics (scraped inside the Docker network)
SENTRY_DSN=                             # optional error tracking; empty = off
SENTRY_TRACES_SAMPLE_RATE=0

PREMIUM_ENFORCED=false
TWELVE_DATA_API_KEY=                    # rotate if it was ever committed
TWELVE_DATA_DAILY_BUDGET=780
FCM_CREDENTIALS_FILE=                   # path inside the container to the Firebase service-account JSON
NEWS_FEEDS=fed,ecb,boe,boj,sec          # publisher feeds only after their terms are confirmed (docs/DATA_SOURCES.md)

BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_S=86400
WEB_CONCURRENCY=2                       # API worker processes (about 1 per CPU core)
